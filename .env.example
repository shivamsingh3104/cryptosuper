PORT=5001

# Admin login. This value is the local-dev default only — if it is not
# placed in the environment, /api/admin/login responds 503 and stays
# disabled. Change this to a unique strong secret in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Legacy shared-secret admin token — sirf tab ke liye jab purana bundle
# abhi deploy hai. Default OFF hai. Naya bundle upload karne ke baad dono
# variables hata dein. Is repo ki git history me ye secret public tha, isliye
# ise turant rotate karein.
# ALLOW_LEGACY_ADMIN_TOKEN=true
# LEGACY_ADMIN_TOKEN=

FRONTEND_URL=http://localhost:3000
ETHERSCAN_API_KEY=your-etherscan-api-key

# Firebase Admin SDK (service account credentials)
# Get these from your Firebase Console > Project Settings > Service Accounts
# Generate a new private key, then the values correspond to:
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Replace \n with actual newlines in the private key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
